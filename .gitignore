# KHONG commit outputs/zoom/*.html (~26 MB, sinh lại bằng
# scripts/make_zoom_figures.py)
outputs/*
!outputs/screenshots/
!outputs/figures/
!outputs/zoom/
outputs/zoom/*
figures/

